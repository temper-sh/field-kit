<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- GENERATED by local-ai-setup — edit templates/com.llamaswap.server.plist.tmpl instead -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.llamaswap.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BREW_PREFIX__/bin/llama-swap</string>
        <string>--config</string>
        <string>__HOME__/.config/llama-swap/config.yaml</string>
        <string>--listen</string>
        <string>127.0.0.1:8080</string>
        <string>--watch-config</string>
    </array>

    <!-- launchd starts services with a bare environment. Without the engine
         binaries on PATH every model launch fails with "command not found",
         which surfaces as an opaque upstream error in llama-swap. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__SERVICE_PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>

        <!-- The models step honours HF_HOME/HF_HUB_CACHE when downloading, but
             launchd gives the service a bare environment, so without this the
             engines would look in the default location and find nothing. -->
        <key>HF_HUB_CACHE</key>
        <string>__HF_HUB_CACHE__</string>

        <!-- rapid-mlx's on-disk KV checkpoint store defaults to a 20 GiB cap
             and sits at it (docs/FINDINGS.md #14). Scaled to free disk by
             steps/50-service.sh so a smaller machine does not silently lose a
             tenth of its space. Raise --kv-disk-checkpoint-interval 0 in
             models.yaml instead if you want the store off entirely. -->
        <key>RAPID_MLX_KV_CHECKPOINT_MAX_BYTES</key>
        <string>__KV_CHECKPOINT_MAX__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash. launchd judges "crash" purely by exit status, so this
         also fires on a stop that overruns ExitTimeOut and gets SIGKILLed. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- `launchctl stop` is SIGTERM, then SIGKILL once this expires. llama-swap
         tears down the upstream engine first, which does not fit in the 5s
         default while a model is resident — so the stop escalated to a kill,
         KeepAlive read the signal death as a crash, and the service came
         straight back. Measured at the default: respawned after 6s; when it did
         get out in time it exited 0 and stayed down.

         This makes `launchctl stop` work. It is not how you keep the service
         down — bootout unloads the job so KeepAlive cannot apply at all:
             launchctl bootout gui/$(id -u)/com.llamaswap.server -->
    <key>ExitTimeOut</key>
    <integer>60</integer>

    <!-- A bad config must not spin-relaunch llama-swap every 10s. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/llama-swap.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/llama-swap.error.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>
</dict>
</plist>
