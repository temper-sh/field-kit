#!/bin/sh
# Reuse installed Python. Reading help and discovery must never install software.
set -eu
field_kit_directory=$(CDPATH='' cd "$(dirname "$0")" && pwd -P)
export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
check_python() {
    [ -n "$1" ] && [ -x "$1" ] && "$1" -B -S -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null
}
field_kit_python=${FIELD_KIT_PYTHON:-}
if [ -z "$field_kit_python" ]; then
    field_kit_python=$(command -v python3 2>/dev/null || true)
fi
if ! check_python "$field_kit_python"; then
    printf '%s\n' 'field-kit: set FIELD_KIT_PYTHON to an installed Python 3.9+ executable. No software was installed.' >&2
    exit 1
fi
exec "$field_kit_python" -B -S -u -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from fieldkit_runtime.cli import main; sys.exit(main())' "$field_kit_directory" "$@"
